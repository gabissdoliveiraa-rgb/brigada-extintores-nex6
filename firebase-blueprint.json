{
  "entities": {
    "Extinguisher": {
      "title": "Extinguisher",
      "description": "Extintor de incêndio cadastrado no sistema SENAI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 40 },
        "type": { "type": "string", "enum": ["Pó Químico ABC", "CO2", "Água", "Espuma Mecânica"] },
        "floor": { "type": "string", "maxLength": 80 },
        "location": { "type": "string", "maxLength": 160 },
        "capacity": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["Em dia", "Atenção", "Vencido"] },
        "purchaseDate": { "type": "string", "maxLength": 40 },
        "expirationDate": { "type": "string", "maxLength": 40 },
        "validityDate": { "type": "string", "maxLength": 40 },
        "nextInspectionDate": { "type": "string", "maxLength": 40 },
        "qrCode": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 1000 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "lastInspectedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "code", "type", "floor", "location", "capacity", "status"]
    },
    "BrigadeMember": {
      "title": "BrigadeMember",
      "description": "Membro integrante da brigada de incêndio SENAI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 80 },
        "isLeader": { "type": "boolean" },
        "jobTitle": { "type": "string", "maxLength": 120 },
        "functionDescription": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 160 },
        "responsibleFloor": { "type": "string", "maxLength": 80 },
        "trainingStatus": { "type": "string", "enum": ["Em dia", "Vencido"] },
        "trainingExpirationDate": { "type": "string", "maxLength": 40 },
        "avatarUrl": { "type": "string", "maxLength": 800000 }
      },
      "required": ["id", "name", "role", "isLeader", "email", "responsibleFloor", "trainingStatus"]
    },
    "Inspection": {
      "title": "Inspection",
      "description": "Registro de inspeção e vistoria periódica de extintor",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 40 },
        "extinguisherCode": { "type": "string", "maxLength": 40 },
        "extinguisherType": { "type": "string", "maxLength": 60 },
        "date": { "type": "string", "maxLength": 40 },
        "responsible": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["Em dia", "Atenção", "Vencido"] },
        "floor": { "type": "string", "maxLength": 80 },
        "location": { "type": "string", "maxLength": 160 },
        "capacity": { "type": "string", "maxLength": 40 },
        "validityDate": { "type": "string", "maxLength": 40 },
        "nextInspectionDate": { "type": "string", "maxLength": 40 },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "extinguisherCode", "date", "responsible", "status"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Aviso de manutenção preventiva ou vencimento de extintores",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "date": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["Vencido", "A vencer", "Pendente"] },
        "extinguisherCode": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "type", "description", "date", "status"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Log auditável imutável de ações executadas no sistema",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "userRole": { "type": "string", "enum": ["Administrador", "Funcionário"] },
        "userEmail": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "enum": ["Extintores", "Inspeções", "Brigada", "Relatórios", "Usuários", "Sistema"] },
        "actionType": { "type": "string", "enum": ["create", "update", "delete", "inspect", "report", "login", "system"] },
        "description": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "maxLength": 60 },
        "formattedDateTime": { "type": "string", "maxLength": 60 },
        "targetCode": { "type": "string", "maxLength": 40 },
        "targetFloor": { "type": "string", "maxLength": 80 },
        "details": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "userName", "userRole", "category", "actionType", "description", "timestamp", "formattedDateTime"]
    },
    "RegisteredUser": {
      "title": "RegisteredUser",
      "description": "Usuário autorizado a acessar o sistema SENAI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["Administrador", "Funcionário"] },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 30 },
        "avatarUrl": { "type": "string", "maxLength": 800000 },
        "responsibleSector": { "type": "string", "maxLength": 80 },
        "birthDate": { "type": "string", "maxLength": 30 },
        "isLeader": { "type": "boolean" },
        "trainingStatus": { "type": "string", "enum": ["Em dia", "Vencido"] },
        "password": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "name", "role", "email"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Registro de permissão administrativa vinculada ao UID do Firebase Auth",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "enum": ["Administrador"] },
        "grantedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": "AdminRole",
      "description": "Coleção de controle de administradores autenticados no Firebase Auth"
    },
    "/extinguishers/{extinguisherId}": {
      "schema": "Extinguisher",
      "description": "Coleção de extintores de combate a incêndio do SENAI"
    },
    "/brigade_members/{memberId}": {
      "schema": "BrigadeMember",
      "description": "Coleção de brigadistas e líderes de emergência"
    },
    "/inspections/{inspectionId}": {
      "schema": "Inspection",
      "description": "Coleção de inspeções e vistorias técnicas"
    },
    "/notices/{noticeId}": {
      "schema": "Notice",
      "description": "Coleção de avisos operacionais"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Coleção de logs de atividades para auditoria"
    },
    "/users/{userId}": {
      "schema": "RegisteredUser",
      "description": "Coleção de usuários autorizados do sistema"
    }
  }
}
